// Mono emoji helper — wraps bare emojis in .mono-icon spans
function monoEmojis(){
  var emojiRe=/(?:[\u{1F300}-\u{1F9FF}]|[\u{2600}-\u{27BF}]|[\u{FE00}-\u{FE0F}]|[\u{1FA00}-\u{1FAFF}]|[\u{200D}]|[\u{20E3}]|[\u{2702}-\u{27B0}])+/gu;
  document.querySelectorAll('.card,.tab,.tag,.section-title,.detail-card,.btn,.step-title').forEach(function(el){
    if(el.querySelector('.mono-icon'))return;
    el.childNodes.forEach(function(node){
      if(node.nodeType===3&&emojiRe.test(node.textContent)){
        var span=document.createElement('span');
        span.innerHTML=node.textContent.replace(emojiRe,function(m){return '<span class="mono-icon">'+m+'</span>'});
        node.parentNode.replaceChild(span,node);
      }
    });
  });
}

